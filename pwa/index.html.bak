<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>家計簿</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --primary:#1a73e8;--success:#34a853;--danger:#ea4335;--warn:#e8a000;
  --bg:#f8f9fa;--card:#fff;--text:#202124;--sub:#5f6368;--border:#dadce0;
  --nav:60px;--top:52px;--r:12px;--sh:0 1px 4px rgba(0,0,0,.12);
}
html,body{height:100%;font-family:Meiryo,'Hiragino Kaku Gothic ProN',sans-serif;font-size:15px;color:var(--text);background:var(--bg);overflow:hidden;-webkit-tap-highlight-color:transparent}
#debug-bar{display:none;position:fixed;top:0;left:0;right:0;padding:6px 12px;background:var(--danger);color:#fff;font-size:12px;z-index:999;word-break:break-all}
#toast{position:fixed;bottom:calc(var(--nav) + 12px);left:50%;transform:translateX(-50%);background:#323232;color:#fff;font-size:13px;padding:8px 18px;border-radius:20px;white-space:nowrap;z-index:500;opacity:0;transition:opacity .25s;pointer-events:none}
#toast.show{opacity:1}
#toast.err{background:var(--danger)}
#topbar{position:fixed;top:0;left:0;right:0;height:var(--top);background:var(--primary);color:#fff;display:flex;align-items:center;padding:0 16px;gap:8px;z-index:100;box-shadow:0 2px 6px rgba(0,0,0,.2)}
#topbar h1{font-size:17px;font-weight:600;flex:1}
#modebadge{font-size:12px;padding:3px 10px;border-radius:20px;background:rgba(255,255,255,.2);cursor:pointer;user-select:none}
#main{position:fixed;top:var(--top);bottom:var(--nav);left:0;right:0;overflow-y:auto;-webkit-overflow-scrolling:touch}
#main::-webkit-scrollbar{display:none}
.screen{display:none;padding:16px 16px 24px;min-height:100%}
.screen.on{display:block}
.card{background:var(--card);border-radius:var(--r);box-shadow:var(--sh);margin-bottom:12px;overflow:hidden}
.ch{padding:10px 16px 8px;font-size:13px;font-weight:600;color:var(--sub);border-bottom:1px solid var(--border)}
.cb{padding:12px 16px}
.field{margin-bottom:14px}
.field:last-child{margin-bottom:0}
.field label{display:block;font-size:13px;color:var(--sub);margin-bottom:4px;font-weight:500}
.field input[type=number],.field input[type=text],.field input[type=password]{width:100%;height:44px;padding:0 12px;border:1.5px solid var(--border);border-radius:8px;font-size:16px;color:var(--text);background:var(--card);outline:none;-webkit-appearance:none;appearance:none}
.field input:focus{border-color:var(--primary)}
.hint{font-size:11px;color:var(--sub);margin-top:3px}
.upa{border:2px dashed var(--border);border-radius:10px;padding:16px;text-align:center;position:relative;margin-bottom:10px;cursor:pointer}
.upa input[type=file]{position:absolute;top:0;left:0;right:0;bottom:0;opacity:0;cursor:pointer;width:100%;height:100%}
.upa .ico{font-size:28px}
.upa .lbl{font-size:14px;font-weight:600;color:var(--primary);margin-top:4px}
.upa .sub{font-size:12px;color:var(--sub)}
.upa.done{border-color:var(--success);background:#e6f4ea}
.upa.done .lbl{color:var(--success)}
.btn{display:block;width:100%;height:48px;border:none;border-radius:24px;font-size:16px;font-weight:600;cursor:pointer;-webkit-appearance:none;appearance:none}
.btn:active{opacity:.8}
.btnp{background:var(--primary);color:#fff}
.btno{background:transparent;border:1.5px solid var(--primary);color:var(--primary)}
.btns{background:var(--success);color:#fff}
.bsm{display:inline-block;width:auto;height:34px;padding:0 16px;font-size:13px;border-radius:17px}
.hero{border-radius:var(--r);padding:24px 20px;margin-bottom:12px;text-align:center;color:#fff}
.hero.p{background:var(--primary);box-shadow:0 2px 8px rgba(26,115,232,.3)}
.hero.d{background:var(--danger);box-shadow:0 2px 8px rgba(234,67,53,.3)}
.hero.s{background:var(--success);box-shadow:0 2px 8px rgba(52,168,83,.3)}
.hero.w{background:var(--warn);box-shadow:0 2px 8px rgba(232,160,0,.3)}
.hero .hl{font-size:13px;opacity:.85;margin-bottom:6px}
.hero .ha{font-size:34px;font-weight:700}
.hero .hs{font-size:12px;opacity:.8;margin-top:4px}
.bdlist{list-style:none}
.bdlist li{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--border);font-size:14px}
.bdlist li:last-child{border-bottom:none}
.bdc{color:var(--sub)}
.bdv{font-weight:600;font-size:15px}
.bdv.d{color:var(--danger)}
.bdv.s{color:var(--success)}
.bdv.w{color:var(--warn)}
.segw{display:flex;gap:8px;margin-bottom:14px}
.segb{flex:1;height:36px;border:1.5px solid var(--border);border-radius:18px;font-size:13px;font-weight:600;background:var(--card);color:var(--sub);cursor:pointer;-webkit-appearance:none;appearance:none}
.segb.on{background:var(--primary);border-color:var(--primary);color:#fff}
.donutw{display:flex;justify-content:center;margin:8px 0 16px}
.catlist{list-style:none}
.catlist li{display:flex;align-items:center;padding:10px 0;border-bottom:1px solid var(--border);gap:10px}
.catlist li:last-child{border-bottom:none}
.cdot{width:12px;height:12px;border-radius:50%;flex-shrink:0}
.cname{flex:1;font-size:14px}
.cpct{font-size:12px;color:var(--sub);min-width:36px;text-align:right}
.camt{font-size:14px;font-weight:600;min-width:80px;text-align:right}
.dsec{margin-top:12px}
.dhdr{display:flex;justify-content:space-between;align-items:center;padding:10px 16px;background:var(--card);border-radius:var(--r);cursor:pointer;font-size:14px;font-weight:600;box-shadow:var(--sh)}
.dhdr .chv{transition:transform .2s;color:var(--sub);font-size:12px}
.dhdr.op .chv{transform:rotate(180deg)}
.dlist{display:none;background:var(--card);border-radius:0 0 var(--r) var(--r);padding:8px 0 4px;margin-top:-8px}
.dlist.op{display:block}
.ditem{display:flex;justify-content:space-between;padding:8px 16px;font-size:13px;border-bottom:1px solid var(--border);gap:8px}
.ditem:last-child{border-bottom:none}
.din{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ddt{color:var(--sub);font-size:11px;white-space:nowrap}
.dam{font-weight:600;white-space:nowrap}
.chip{display:inline-block;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:600;background:#e8f0fe;color:var(--primary)}
.chip.g{background:#e6f4ea;color:var(--success)}
.stitle{font-size:12px;font-weight:700;color:var(--sub);letter-spacing:.06em;text-transform:uppercase;margin:16px 0 8px}
.stitle:first-child{margin-top:0}
#botnav{position:fixed;bottom:0;left:0;right:0;height:var(--nav);background:var(--card);border-top:1px solid var(--border);display:flex;z-index:100}
.navi{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;cursor:pointer;color:var(--sub);font-size:10px;font-weight:500;border:none;background:none;padding:6px 0;-webkit-appearance:none;appearance:none}
.navi.on{color:var(--primary)}
.navi .nic{font-size:22px;line-height:1}
.moverlay{display:none;position:fixed;inset:0;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:200;align-items:flex-end;justify-content:center}
.moverlay.op{display:flex}
.msheet{background:var(--card);border-radius:20px 20px 0 0;padding:24px 20px 32px;width:100%;max-width:480px}
.msheet h2{font-size:17px;margin-bottom:16px}
.macts{display:flex;gap:10px;margin-top:16px}
.macts .btn{flex:1}
.merr{color:var(--danger);font-size:13px;margin-top:8px;display:none}
.merr.on{display:block}
.hidden{display:none!important}
.mt8{margin-top:8px}
.mt16{margin-top:16px}
.tc{text-align:center}
.empty{text-align:center;padding:40px 20px;color:var(--sub)}
.empty .ei{font-size:48px;margin-bottom:12px}
@supports (padding-bottom: env(safe-area-inset-bottom)){
  #botnav{padding-bottom:env(safe-area-inset-bottom);height:calc(var(--nav) + env(safe-area-inset-bottom))}
  #main{bottom:calc(var(--nav) + env(safe-area-inset-bottom))}
}
</style>
</head>
<body>

<div id="debug-bar"></div>
<div id="toast"></div>

<header id="topbar">
  <h1>家計簿</h1>
  <div id="modebadge">妻モード</div>
</header>

<main id="main">

  <!-- 入力画面 -->
  <section id="sc-input" class="screen on">
    <p class="stitle">クレジットカード明細</p>
    <div class="card"><div class="cb">
      <div class="upa" id="upa-amex">
        <input type="file" accept=".csv" id="f-amex">
        <div class="ico">&#128179;</div>
        <div class="lbl" id="lbl-amex">Amex CSV を選択</div>
        <div class="sub">アメックスゴールドプリファード</div>
      </div>
      <div class="upa" id="upa-jcb">
        <input type="file" accept=".csv" id="f-jcb">
        <div class="ico">&#128179;</div>
        <div class="lbl" id="lbl-jcb">JCB CSV を選択</div>
        <div class="sub">ANA JCB CARD FIRST</div>
      </div>
      <div class="field mt8">
        <label>クレカ合計金額（自動入力・修正可）</label>
        <input type="number" id="i-credit" min="0" placeholder="0">
        <div class="hint">CSVを読み込むと自動で計算されます</div>
      </div>
    </div></div>

    <p class="stitle hidden" id="salary-stitle">給与・精算</p>
    <div class="card hidden" id="salary-card"><div class="cb">
      <div class="field">
        <label>手取り給与（旅費含む）</label>
        <input type="number" id="i-salary" min="0" placeholder="0">
      </div>
      <div class="field">
        <label>旅費（給与内の交通費精算分）</label>
        <input type="number" id="i-travel" min="0" placeholder="0">
      </div>
    </div></div>

    <p class="stitle">個人支払い</p>
    <div class="card"><div class="cb">
      <div class="field" id="fhp">
        <label>夫の個人支払い合計</label>
        <input type="number" id="i-hp" min="0" placeholder="0">
        <div class="hint">クレカ明細のうち夫個人分の合計</div>
      </div>
      <div class="field">
        <label>妻の個人支払い合計</label>
        <input type="number" id="i-wp" min="0" placeholder="0">
      </div>
    </div></div>

    <p class="stitle">共用口座</p>
    <div class="card"><div class="cb">
      <div class="field">
        <label>現在の共用口座残高</label>
        <input type="number" id="i-bal" min="0" placeholder="0">
        <div class="hint">計算実行時点の残高を入力</div>
      </div>
    </div></div>

    <div class="mt16">
      <button class="btn btnp" id="btn-calc">計算する</button>
    </div>
  </section>

  <!-- 結果画面 -->
  <section id="sc-result" class="screen">
    <div id="r-hero" class="hero p">
      <div class="hl" id="r-lbl">投資引き出し必要額</div>
      <div class="ha" id="r-amt">-</div>
      <div class="hs" id="r-sub"></div>
    </div>
    <div class="card">
      <div class="ch">今月の振込内容</div>
      <div class="cb"><ul class="bdlist" id="r-trans"></ul></div>
    </div>
    <div class="card">
      <div class="ch">共用口座 収支内訳</div>
      <div class="cb"><ul class="bdlist" id="r-shared"></ul></div>
    </div>
    <div class="card hidden" id="r-salary-card">
      <div class="ch">給与口座 内訳</div>
      <div class="cb"><ul class="bdlist" id="r-salary"></ul></div>
    </div>
    <p class="tc mt8" style="font-size:12px;color:var(--sub)" id="r-date"></p>
  </section>

  <!-- 支出内訳画面 -->
  <section id="sc-cat" class="screen">
    <div class="segw">
      <button class="segb on" data-seg="all">合計</button>
      <button class="segb" data-seg="husband">夫</button>
      <button class="segb" data-seg="wife">妻</button>
    </div>
    <div class="card"><div class="cb" style="padding-bottom:8px">
      <div class="donutw">
        <svg id="donut" width="200" height="200" viewBox="-100 -100 200 200">
          <circle cx="0" cy="0" r="65" fill="var(--bg)"/>
          <g id="dsegs"></g>
          <text id="dtotal" x="0" y="0" text-anchor="middle" dominant-baseline="middle" style="font-size:14px;font-weight:700;fill:var(--text)"></text>
          <text x="0" y="18" text-anchor="middle" dominant-baseline="middle" style="font-size:10px;fill:var(--sub)">合計 円</text>
        </svg>
      </div>
      <ul class="catlist" id="catlist"></ul>
    </div></div>
    <div class="stitle">明細一覧</div>
    <div id="accordion"></div>
    <div class="empty hidden" id="cat-empty">
      <div class="ei">&#128202;</div>
      <p>CSVを読み込むと<br>支出内訳が表示されます</p>
    </div>
  </section>

  <!-- 設定画面 -->
  <section id="sc-set" class="screen">
    <div class="card hidden" id="mode-card"><div class="ch">表示モード</div><div class="cb">
      <p style="font-size:14px;margin-bottom:10px">現在: <strong id="curmode">妻モード</strong></p>
      <div style="display:flex;gap:10px;margin-bottom:16px">
        <button class="btn btno bsm" id="btn-sw-wife">妻モードへ切替</button>
        <button class="btn btnp bsm" id="btn-sw-husb">夫モードへ切替</button>
      </div>
      <div class="field">
        <label>夫モード パスワード（空欄＝変更なし）</label>
        <input type="password" id="s-hpw" placeholder="新しいパスワード">
      </div>
      <div class="field">
        <label>妻モード パスワード（空欄＝変更なし）</label>
        <input type="password" id="s-wpw" placeholder="新しいパスワード">
      </div>
    </div></div>

    <div class="card"><div class="ch">固定設定値</div><div class="cb">
      <div class="field">
        <label>共用口座の目標残高（円）</label>
        <input type="number" id="s-target" min="0">
      </div>
      <div class="field">
        <label>毎月の投資額（円）</label>
        <input type="number" id="s-invest" min="0">
      </div>
      <div class="field">
        <label>生活費月額（円）</label>
        <input type="number" id="s-living" min="0">
        <div class="hint">自動振込額 = 投資額 + 生活費月額</div>
      </div>
      <div class="field">
        <label>ローン月額（円）</label>
        <input type="number" id="s-loan" min="0">
      </div>
      <div class="field">
        <label>妻へのお小遣い月額（円）</label>
        <input type="number" id="s-wallow" min="0">
      </div>
    </div></div>

    <div class="card hidden" id="amex-card"><div class="ch">Amex カード設定</div><div class="cb">
      <div class="field">
        <label>Amex CSV の夫のカード会員名</label>
        <input type="text" id="s-hname" placeholder="例: タクミ サトウ">
        <div class="hint">CSVに記載されている名前（CSVを読み込むと候補が表示されます）</div>
      </div>
      <div class="hidden" id="namechips-wrap">
        <div class="hint" style="margin-top:4px">CSVから検出した会員名（タップで設定）：</div>
        <div id="namechips" style="margin-top:6px;display:flex;gap:6px;flex-wrap:wrap"></div>
      </div>
    </div></div>

    <div class="mt16">
      <button class="btn btnp" id="btn-save">設定を保存</button>
    </div>
    <p class="tc mt8" style="font-size:12px;color:var(--sub)" id="savemsg"></p>
  </section>

</main>

<nav id="botnav">
  <button class="navi on" data-sc="input">
    <span class="nic">&#9999;</span><span>入力</span>
  </button>
  <button class="navi" data-sc="result">
    <span class="nic">&#128202;</span><span>結果</span>
  </button>
  <button class="navi" data-sc="cat">
    <span class="nic">&#127974;</span><span>内訳</span>
  </button>
  <button class="navi" data-sc="set">
    <span class="nic">&#9881;</span><span>設定</span>
  </button>
</nav>

<!-- パスワードモーダル -->
<div class="moverlay" id="modal">
  <div class="msheet">
    <h2 id="mtitle">モード切替</h2>
    <div class="field">
      <label>パスワード</label>
      <input type="password" id="mpw" placeholder="パスワードを入力">
    </div>
    <p class="merr" id="merr">パスワードが違います</p>
    <div class="macts">
      <button class="btn btno" id="mcancel">キャンセル</button>
      <button class="btn btnp" id="mok">切替</button>
    </div>
  </div>
</div>

<script>
// ===== 動作確認（最初に実行） =====
(function(){
  var d = document.getElementById('debug-bar');
  if(d){ d.textContent='JavaScript: 読み込み中...'; d.style.display='block'; d.style.background='#1a73e8'; }
})();

// ===== ストレージ =====
var SK = { SET:'kb_settings', IN:'kb_input', HIST:'kb_history' };
var DEF = { targetBalance:350000, investment:100000, livingExpenses:90000, loan:0, wifeAllowance:0, husbandAmexName:'', husbandPassword:'', wifePassword:'' };

function getSettings(){
  try{ var s=localStorage.getItem(SK.SET); return s ? merge(JSON.parse(s),DEF) : merge({},DEF); }catch(e){ return merge({},DEF); }
}
function saveSettings(s){ localStorage.setItem(SK.SET,JSON.stringify(s)); }
function getLastInput(){ try{ var s=localStorage.getItem(SK.IN); return s?JSON.parse(s):null; }catch(e){ return null; } }
function saveLastInput(d){ try{ localStorage.setItem(SK.IN,JSON.stringify(d)); }catch(e){} }
function saveToHistory(e){ try{ var h=getHistory(); var k=e.yearMonth; var i=findIdx(h,k); if(i>=0)h[i]=e; else{ h.unshift(e); if(h.length>24)h.pop(); } localStorage.setItem(SK.HIST,JSON.stringify(h)); }catch(ex){} }
function getHistory(){ try{ var s=localStorage.getItem(SK.HIST); return s?JSON.parse(s):[]; }catch(e){ return []; } }
function findIdx(arr,ym){ for(var i=0;i<arr.length;i++)if(arr[i].yearMonth===ym)return i; return -1; }
function merge(obj,def){ var r={}; for(var k in def)r[k]=def[k]; for(var k in obj)r[k]=obj[k]; return r; }

var _mode = 'wife';
function getMode(){ return _mode; }
function setMode(m){ _mode=m; }

function hashPw(pw){
  if(!pw)return '';
  var h=0;
  for(var i=0;i<pw.length;i++){ h=((h<<5)-h)+pw.charCodeAt(i); h|=0; }
  return 'h'+Math.abs(h).toString(36);
}
function verifyPw(pw,stored){ if(!stored)return true; return hashPw(pw)===stored; }

// ===== CSV パーサー =====
function parseCSV(text){
  var rows=[],row=[],field='',inQ=false;
  for(var i=0;i<text.length;i++){
    var c=text[i];
    if(c==='"'){ if(inQ&&text[i+1]==='"'){field+='"';i++;}else{inQ=!inQ;} }
    else if(c===','&&!inQ){ row.push(field.trim());field=''; }
    else if((c==='\n'||c==='\r')&&!inQ){
      if(c==='\r'&&text[i+1]==='\n')i++;
      row.push(field.trim());
      var empty=true; for(var j=0;j<row.length;j++)if(row[j]!==''){empty=false;break;}
      if(!empty)rows.push(row);
      row=[];field='';
    } else { field+=c; }
  }
  if(field!==''||row.length>0){ row.push(field.trim()); var e2=true; for(var j=0;j<row.length;j++)if(row[j]!==''){e2=false;break;} if(!e2)rows.push(row); }
  return rows;
}

function parseAmt(s){
  if(!s)return 0;
  var v=parseFloat(String(s).replace(/[,\s"]/g,''));
  return isNaN(v)?0:v;
}

function last4(s){
  var m=String(s).match(/\*{4}-\*{4}-\*{4}-(\d{4})/);
  return m?m[1]:'';
}

var CATS=[
  {n:'食費',k:['スーパー','SUPER','MARKET','マーケット','GROCERY','GROCER','コンビニ','SEVEN','ファミマ','FAMILYMART','LAWSON','ローソン','ミニスト','イオン','AEON','マクド','MCDONALDS','BURGER','PIZZA','SUSHI','レストラン','RESTAURANT','CAFE','カフェ','コーヒー','COFFEE','STARBUCKS','スタバ','ドトール','TULLYS','WHOLE','DELI','KATZ','ESS-A','BAGEL','PROTEIN','TASTE','IN-N-OUT','MARU','FISHS','TST','FOOD','弁当','総菜','食料']},
  {n:'交通費',k:['電車','鉄道','バス','タクシー','ETC','TAXI','UBER','LYFT','METRO','TRANSIT','PAYGO','AIRPORT','AIRLINE','DELTA','UNITED','PRIORITY PASS','NYCT','SUBWAY','交通','高速','パスモ','スイカ','LA METRO','LA-TRANSIT']},
  {n:'旅行・宿泊',k:['HOTEL','ホテル','INN','SUITES','HOLIDAY','STAYBRIDGE','AIRBNB','旅行','GRAYSON','CRUISE']},
  {n:'娯楽費',k:['映画','MOVIE','THEATER','CINEMA','BROADWAY','PHANTOM','ゲーム','GAME','カラオケ','MUSEUM']},
  {n:'買い物・衣服',k:['AMAZON','アマゾン','NIKE','ナイキ','UNIQLO','ユニクロ','ZARA','GU','LIDS','ONLY NY','TARGET','SHOP','ショッピング']},
  {n:'日用品・薬',k:['ドラッグ','DRUG','PHARMACY','CVS','WALGREEN','サンドラッグ','薬局']},
  {n:'通信・サービス',k:['GOOGLE','APPLE','MICROSOFT','NETFLIX','SPOTIFY','ドコモ','AU','ソフトバンク','スマート電気','電気','ガス']},
  {n:'医療・美容',k:['病院','クリニック','HOSPITAL','CLINIC','MEDICAL','美容','BEAUTY','SALON','皮膚科','歯科']},
];

function categorize(desc){
  var u=(desc||'').toUpperCase();
  for(var i=0;i<CATS.length;i++){
    var k=CATS[i].k;
    for(var j=0;j<k.length;j++){
      if(u.indexOf(k[j].toUpperCase())>=0)return CATS[i].n;
    }
  }
  return 'その他';
}

var AMEX_PAY_KW=['振替','支払い','PAYMENT','TRANSFER'];
function isAmexPay(desc){ for(var i=0;i<AMEX_PAY_KW.length;i++)if(desc.indexOf(AMEX_PAY_KW[i])>=0)return true; return false; }

function parseAmex(text){
  var rows=parseCSV(text);
  if(rows.length<2)return{total:0,transactions:[],cardHolders:[]};
  var txns=[],holders={};
  for(var i=1;i<rows.length;i++){
    var r=rows[i];
    if(r.length<6)continue;
    var desc=(r[2]||'').trim();
    if(isAmexPay(desc))continue;
    var amt=parseAmt(r[5]);
    var holder=(r[3]||'').trim();
    if(holder)holders[holder]=1;
    txns.push({date:(r[0]||'').trim(),description:desc,cardHolder:holder,amount:amt,category:categorize(desc),source:'amex'});
  }
  var raw=0; for(var i=0;i<txns.length;i++)raw+=txns[i].amount;
  var hArr=[]; for(var k in holders)hArr.push(k);
  return{total:Math.round(raw<0?0:raw),transactions:txns,cardHolders:hArr};
}

function parseJCB(text){
  var rows=parseCSV(text);
  if(rows.length<6)return{total:0,transactions:[]};
  var total=0;
  for(var i=0;i<Math.min(5,rows.length);i++){
    var r=rows[i], rt='';
    for(var j=0;j<r.length;j++)rt+=r[j];
    if(rt.indexOf('合計')>=0&&rt.indexOf('国内')<0&&rt.indexOf('海外')<0&&rt.indexOf('利用')<0){
      for(var j=0;j<r.length;j++){var v=parseAmt(r[j]);if(v>100){total=v;break;}}
      if(total>0)break;
    }
  }
  var txns=[];
  for(var i=6;i<rows.length;i++){
    var r=rows[i];
    if(!r[0]||r[0].indexOf('****')<0)continue;
    var desc=(r[3]||'').trim();
    var amt=parseAmt(r[4]);
    txns.push({cardLast4:last4(r[0]),jcbCategory:(r[1]||'').trim(),date:(r[2]||'').trim(),description:desc,amount:amt,category:categorize(desc),source:'jcb'});
  }
  if(!total)for(var i=0;i<txns.length;i++)total+=txns[i].amount;
  return{total:Math.round(total),transactions:txns};
}

function readCSV(file){
  return new Promise(function(res,rej){
    var reader=new FileReader();
    reader.onload=function(e){ res(e.target.result); };
    reader.onerror=function(){ rej(new Error('読み込み失敗')); };
    reader.readAsText(file,'Shift_JIS');
  });
}

// ===== 計算 =====
function calculate(inp,set){
  var salary=inp.salary,travel=inp.travel,hp=inp.hp,wp=inp.wp,bal=inp.bal,credit=inp.credit;
  var target=set.targetBalance,inv=set.investment,living=set.livingExpenses,loan=set.loan,wa=set.wifeAllowance;
  // 自動振込 = 投資額 + 生活費（投資は自動振込収入と支出で相殺のため共用口座収支から除外）
  var auto=inv+living;
  var adj=target-bal+credit+loan+wa-living-travel-hp-wp;
  var adjNeeded=adj>0?Math.round(adj):0;
  var surplus=adj<0?Math.round(-adj):0;
  var free=Math.round(salary-auto-travel);
  var need=hp+adjNeeded;
  var investOut=Math.max(0,Math.round(need-free));
  // お小遣い = 手取り − 自動振込(投資+生活費) − 旅費 − 夫個人支払い
  var allowance=Math.max(0,Math.round(salary-auto-travel-hp));
  return{adjNeeded:adjNeeded,surplus:surplus,investOut:investOut,free:free,need:Math.round(need),allowance:allowance,credit:Math.round(credit),auto:Math.round(auto),totalOut:Math.round(credit+inv+loan+wa)};
}

function summarize(txns,husbName){
  var map={};
  for(var i=0;i<txns.length;i++){
    var t=txns[i];
    if(t.amount<=0)continue;
    var c=t.category||'その他';
    if(!map[c])map[c]={total:0,husband:0,wife:0,items:[]};
    map[c].total+=t.amount;
    map[c].items.push(t);
    if(t.source==='jcb') map[c].husband+=t.amount;
    else if(t.source==='amex'){
      if(husbName&&t.cardHolder===husbName) map[c].husband+=t.amount;
      else map[c].wife+=t.amount;
    }
  }
  var arr=[];
  for(var k in map)arr.push({name:k,total:map[k].total,husband:map[k].husband,wife:map[k].wife,items:map[k].items});
  arr.sort(function(a,b){return b.total-a.total;});
  return arr;
}

function yen(n){ return Math.round(n).toLocaleString()+'円'; }

// ===== アプリ =====
var ST={amex:null,jcb:null,result:null,txns:[],seg:'all',pendingMode:null};
var COLORS=['#4285f4','#ea4335','#fbbc04','#34a853','#ff6d00','#46bdc6','#9c27b0','#795548','#607d8b'];

function dbg(msg){
  var el=document.getElementById('debug-bar');
  if(el){el.textContent=msg;el.style.display='block';el.style.background='#ea4335';}
  console.error(msg);
}
var _ti=null;
function toast(msg,err){
  var el=document.getElementById('toast');
  if(!el)return;
  el.textContent=msg;
  el.className=err?'show err':'show';
  if(_ti)clearTimeout(_ti);
  _ti=setTimeout(function(){el.className='';},err?4000:2500);
}

function el(id){ return document.getElementById(id); }
function numv(id){ var e=el(id); if(!e)return 0; var v=parseFloat(e.value); return isNaN(v)?0:v; }
function setv(id,val){ var e=el(id); if(e)e.value=(val!==undefined&&val!==null)?val:''; }
function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function pad2(n){ return n<10?'0'+n:''+n; }

// ナビゲーション
function initNav(){
  var btns=document.querySelectorAll('.navi');
  for(var i=0;i<btns.length;i++){
    (function(b){
      b.addEventListener('click',function(){ goScreen(b.getAttribute('data-sc')); });
    })(btns[i]);
  }
}

function goScreen(name){
  var all=document.querySelectorAll('.screen');
  for(var i=0;i<all.length;i++)all[i].classList.remove('on');
  var nav=document.querySelectorAll('.navi');
  for(var i=0;i<nav.length;i++)nav[i].classList.remove('on');
  var sc=el('sc-'+name);
  if(!sc){dbg('sc not found: '+name);return;}
  sc.classList.add('on');
  var nb=document.querySelector('.navi[data-sc="'+name+'"]');
  if(nb)nb.classList.add('on');
  if(name==='result'&&ST.result)renderResult();
  if(name==='cat')renderCat();
  if(name==='set'){loadSettingsForm();updateModeBtns();}
}

// CSV アップロード
function initUploads(){
  setupUp('f-amex','upa-amex','lbl-amex','Amex',function(text,name){
    try{
      ST.amex=parseAmex(text);
      var a=el('upa-amex'),l=el('lbl-amex');
      if(a)a.classList.add('done');
      if(l)l.textContent=name+'（'+ST.amex.transactions.length+'件）';
      updateCredit();
      showNames(ST.amex.cardHolders);
      toast('Amex 読込完了：'+ST.amex.transactions.length+'件');
    }catch(e){dbg('Amex parse error: '+e.message);}
  });
  setupUp('f-jcb','upa-jcb','lbl-jcb','JCB',function(text,name){
    try{
      ST.jcb=parseJCB(text);
      var a=el('upa-jcb'),l=el('lbl-jcb');
      if(a)a.classList.add('done');
      if(l)l.textContent=name+'（'+ST.jcb.transactions.length+'件）';
      updateCredit();
      toast('JCB 読込完了：'+ST.jcb.transactions.length+'件');
    }catch(e){dbg('JCB parse error: '+e.message);}
  });
}

function setupUp(fid,aid,lid,name,handler){
  var input=el(fid);
  if(!input){dbg(fid+' not found');return;}
  input.addEventListener('change',function(e){
    var f=e.target.files&&e.target.files[0];
    if(!f)return;
    readCSV(f).then(function(text){
      handler(text,f.name);
    }).catch(function(err){
      toast(name+' 読込失敗: '+err.message,true);
    });
  });
}

function updateCredit(){
  var a=ST.amex?ST.amex.total:0, j=ST.jcb?ST.jcb.total:0;
  var e=el('i-credit'); if(e)e.value=a+j;
}

function showNames(names){
  var wrap=el('namechips-wrap'),chips=el('namechips');
  if(!names||!names.length||!wrap||!chips){if(wrap)wrap.classList.add('hidden');return;}
  wrap.classList.remove('hidden');
  chips.innerHTML='';
  for(var i=0;i<names.length;i++){
    (function(n){
      var chip=document.createElement('span');
      chip.className='chip';
      chip.textContent=n;
      chip.style.cursor='pointer';
      chip.addEventListener('click',function(){
        var e=el('s-hname');if(e)e.value=n;
        toast('「'+n+'」を夫の会員名に設定しました');
      });
      chips.appendChild(chip);
    })(names[i]);
  }
}

// 計算
function initCalc(){
  var btn=el('btn-calc');
  if(!btn){dbg('btn-calc not found');return;}
  btn.addEventListener('click',function(){
    var salary=numv('i-salary'), bal=numv('i-bal');
    if(!salary){toast('手取り給与を入力してください',true);return;}
    if(!bal&&bal!==0){toast('共用口座の現在残高を入力してください',true);return;}
    var inp={salary:salary,travel:numv('i-travel'),hp:numv('i-hp'),wp:numv('i-wp'),bal:bal,credit:numv('i-credit')};
    try{
      ST.result=calculate(inp,getSettings());
    }catch(e){dbg('calc error: '+e.message);return;}
    ST.txns=[];
    if(ST.amex)for(var i=0;i<ST.amex.transactions.length;i++)ST.txns.push(ST.amex.transactions[i]);
    if(ST.jcb) for(var i=0;i<ST.jcb.transactions.length;i++) ST.txns.push(ST.jcb.transactions[i]);
    saveLastInput({salary:salary,travel:numv('i-travel'),hp:numv('i-hp'),wp:numv('i-wp'),bal:bal,credit:numv('i-credit')});
    var now=new Date();
    saveToHistory({yearMonth:now.getFullYear()+'/'+pad2(now.getMonth()+1),savedAt:now.toISOString(),result:ST.result});
    goScreen('result');
  });
}

// 結果描画
function renderResult(){
  var r=ST.result; if(!r)return;
  var isH=getMode()==='husband';
  var hero=el('r-hero'),lbl=el('r-lbl'),amt=el('r-amt'),sub=el('r-sub');
  if(!hero)return;
  hero.className='hero';
  if(r.investOut>0){
    hero.classList.add('d');
    lbl.textContent='投資から引き出す必要があります';
    amt.textContent=yen(r.investOut);
    sub.textContent='給与口座へ入金後、共用口座へ移してください';
  } else if(r.surplus>0){
    hero.classList.add('w');
    lbl.textContent='今月は余剰があります';
    amt.textContent=yen(r.surplus);
    sub.textContent='この金額は給与口座に残ります';
  } else {
    hero.classList.add('s');
    lbl.textContent='投資の引き出し';
    amt.textContent='不要';
    sub.textContent='給与口座の残高だけで対応できます';
  }
  var set=getSettings();
  var hp=numv('i-hp'),wp=numv('i-wp'),sal=numv('i-salary'),tr=numv('i-travel');
  var tl=el('r-trans'); if(tl){tl.innerHTML='';
    if(r.adjNeeded>0)addRow(tl,'共用口座への調整振込',r.adjNeeded,'');
    if(hp>0)addRow(tl,'夫の個人支払い振込',hp,'');
    if(wp>0)addRow(tl,'妻の個人支払い振込',wp,'');
    if(r.surplus>0)addRow(tl,'余剰（給与口座に残す）',r.surplus,'s');
    if(r.investOut>0)addRow(tl,'投資引き出し後→共用口座へ',r.investOut,'d');
  }
  var sl=el('r-shared'); if(sl){sl.innerHTML='';
    addRow(sl,'自動振込（投資＋生活費）',r.auto,'');
    if(r.adjNeeded>0)addRow(sl,'調整振込',r.adjNeeded,'');
    if(hp>0)addRow(sl,'夫 個人振込',hp,'');
    if(wp>0)addRow(sl,'妻 個人振込',wp,'');
    addRow(sl,'クレカ支払い合計',r.credit,'');
    addRow(sl,'投資積立',set.investment,'');
    if(set.loan)addRow(sl,'ローン',set.loan,'');
    if(set.wifeAllowance)addRow(sl,'妻お小遣い',set.wifeAllowance,'');
  }
  var sc=el('r-salary-card');
  if(sc){
    if(isH){
      sc.classList.remove('hidden');
      var sl2=el('r-salary'); if(sl2){sl2.innerHTML='';
        addRow(sl2,'手取り給与',sal,'');
        addRow(sl2,'旅費（共用へ）',tr,'');
        addRow(sl2,'自動振込（投資＋生活費）',r.auto,'');
        addRow(sl2,'手元残り',r.free,'');
        addRow(sl2,'共用への手動振込合計',r.need,'');
        if(r.investOut>0)addRow(sl2,'投資引き出し（共用へ）',r.investOut,'d');
        addRow(sl2,'実質お小遣い',r.allowance,r.allowance>0?'s':'');
      }
    } else { sc.classList.add('hidden'); }
  }
  var de=el('r-date');
  if(de){var now=new Date();de.textContent=now.getFullYear()+'年'+(now.getMonth()+1)+'月の計算結果';}
}

function addRow(list,label,val,cls){
  var li=document.createElement('li');
  li.innerHTML='<span class="bdc">'+esc(label)+'</span><span class="bdv'+(cls?' '+cls:'')+'">'+yen(val)+'</span>';
  list.appendChild(li);
}

// カテゴリ
function initSegs(){
  var btns=document.querySelectorAll('.segb');
  for(var i=0;i<btns.length;i++){
    (function(b){
      b.addEventListener('click',function(){
        var all=document.querySelectorAll('.segb');
        for(var j=0;j<all.length;j++)all[j].classList.remove('on');
        b.classList.add('on');
        ST.seg=b.getAttribute('data-seg');
        renderCat();
      });
    })(btns[i]);
  }
}

function renderCat(){
  var empty=el('cat-empty');
  if(!ST.txns.length){
    if(empty)empty.classList.remove('hidden');
    var cl=el('catlist');if(cl)cl.innerHTML='';
    var ac=el('accordion');if(ac)ac.innerHTML='';
    drawDonut([]);return;
  }
  if(empty)empty.classList.add('hidden');
  var set=getSettings();
  var cats=summarize(ST.txns,set.husbandAmexName);
  var filtered=[];
  for(var i=0;i<cats.length;i++){
    var c=cats[i],d=c.total;
    if(ST.seg==='husband')d=c.husband;
    if(ST.seg==='wife')d=c.wife;
    if(d>0)filtered.push({name:c.name,total:c.total,husband:c.husband,wife:c.wife,displayAmount:d,items:c.items});
  }
  var tot=0;for(var i=0;i<filtered.length;i++)tot+=filtered[i].displayAmount;
  var ddata=[];
  for(var i=0;i<filtered.length;i++)ddata.push({v:filtered[i].displayAmount,c:COLORS[i%COLORS.length]});
  drawDonut(ddata);
  var dt=el('dtotal');if(dt)dt.textContent=Math.round(tot).toLocaleString();
  var cl=el('catlist');
  if(cl){cl.innerHTML='';
    for(var i=0;i<filtered.length;i++){
      var fc=filtered[i],pct=tot>0?Math.round(fc.displayAmount/tot*100):0;
      var li=document.createElement('li');
      li.innerHTML='<span class="cdot" style="background:'+COLORS[i%COLORS.length]+'"></span><span class="cname">'+esc(fc.name)+'</span><span class="cpct">'+pct+'%</span><span class="camt">'+yen(fc.displayAmount)+'</span>';
      cl.appendChild(li);
    }
  }
  var ac=el('accordion');if(!ac)return;ac.innerHTML='';
  for(var i=0;i<filtered.length;i++){
    (function(fc,ci){
      var items=[];
      for(var j=0;j<fc.items.length;j++){
        var t=fc.items[j];if(t.amount<=0)continue;
        if(ST.seg==='husband'&&!(t.source==='jcb'||(t.source==='amex'&&t.cardHolder===set.husbandAmexName)))continue;
        if(ST.seg==='wife'&&!(t.source==='amex'&&t.cardHolder!==set.husbandAmexName))continue;
        items.push(t);
      }
      if(!items.length)return;
      var sec=document.createElement('div');sec.className='dsec';
      var hdr=document.createElement('div');hdr.className='dhdr';
      hdr.innerHTML='<span><span class="cdot" style="background:'+COLORS[ci%COLORS.length]+';display:inline-block;margin-right:8px;vertical-align:middle"></span>'+esc(fc.name)+'</span><span>'+yen(fc.displayAmount)+' <span class="chv">&#9660;</span></span>';
      var dl=document.createElement('div');dl.className='dlist';
      var shown=items.length>50?items.slice(0,50):items;
      for(var j=0;j<shown.length;j++){
        var t=shown[j],src=t.source==='jcb'?'JCB':'Amex';
        var di=document.createElement('div');di.className='ditem';
        di.innerHTML='<span class="din">'+esc(t.description)+'</span><span class="ddt">'+esc((t.date||'').replace(/\s/g,''))+' <span class="chip">'+src+'</span></span><span class="dam">'+yen(t.amount)+'</span>';
        dl.appendChild(di);
      }
      hdr.addEventListener('click',function(){hdr.classList.toggle('op');dl.classList.toggle('op');});
      sec.appendChild(hdr);sec.appendChild(dl);ac.appendChild(sec);
    })(filtered[i],i);
  }
}

function drawDonut(segs){
  var g=el('dsegs');if(!g)return;g.innerHTML='';
  if(!segs.length)return;
  var tot=0;for(var i=0;i<segs.length;i++)tot+=segs[i].v;
  if(!tot)return;
  var R=80,r=50,angle=-Math.PI/2;
  for(var i=0;i<segs.length;i++){
    var sw=(segs[i].v/tot)*2*Math.PI;
    var x1=Math.cos(angle)*R,y1=Math.sin(angle)*R;
    var x2=Math.cos(angle+sw)*R,y2=Math.sin(angle+sw)*R;
    var xi1=Math.cos(angle)*r,yi1=Math.sin(angle)*r;
    var xi2=Math.cos(angle+sw)*r,yi2=Math.sin(angle+sw)*r;
    var lg=sw>Math.PI?1:0;
    var p=document.createElementNS('http://www.w3.org/2000/svg','path');
    p.setAttribute('d','M '+xi1+' '+yi1+' L '+x1+' '+y1+' A '+R+' '+R+' 0 '+lg+' 1 '+x2+' '+y2+' L '+xi2+' '+yi2+' A '+r+' '+r+' 0 '+lg+' 0 '+xi1+' '+yi1+' Z');
    p.setAttribute('fill',segs[i].c);
    g.appendChild(p);
    angle+=sw;
  }
}

// 設定
function loadSettingsForm(){
  var s=getSettings();
  setv('s-target',s.targetBalance);
  setv('s-invest',s.investment);setv('s-living',s.livingExpenses);setv('s-loan',s.loan);
  setv('s-wallow',s.wifeAllowance);setv('s-hname',s.husbandAmexName);
}
function updateModeBtns(){
  var m=getMode();
  var cl=el('curmode');if(cl)cl.textContent=m==='husband'?'夫モード':'通常モード';
  var hw=el('btn-sw-husb');if(hw)hw.style.display=m==='husband'?'none':'';
  var ww=el('btn-sw-wife');if(ww)ww.style.display=m==='wife'?'none':'';
  var bd=el('modebadge');
  if(bd){
    bd.textContent='夫モード';
    bd.style.display=m==='husband'?'':'none';
  }
}
function initSettingsForm(){
  var btn=el('btn-save');
  if(!btn){dbg('btn-save not found');return;}
  btn.addEventListener('click',function(){
    try{
      var s=getSettings();
      s.targetBalance=numv('s-target');
      s.investment=numv('s-invest');s.livingExpenses=numv('s-living');
      s.loan=numv('s-loan');s.wifeAllowance=numv('s-wallow');
      var ne=el('s-hname');if(ne)s.husbandAmexName=ne.value.trim();
      var hp=el('s-hpw'),wp=el('s-wpw');
      if(hp&&hp.value)s.husbandPassword=hashPw(hp.value);
      if(wp&&wp.value)s.wifePassword=hashPw(wp.value);
      saveSettings(s);
      if(hp)hp.value='';if(wp)wp.value='';
      toast('設定を保存しました');
    }catch(e){toast('保存に失敗: '+e.message,true);dbg('save error: '+e.message);}
  });
}

// モード切替
function addLongPress(target,ms,fn){
  var t=null;
  target.addEventListener('touchstart',function(){t=setTimeout(fn,ms);},false);
  target.addEventListener('touchend',function(){if(t){clearTimeout(t);t=null;}},false);
  target.addEventListener('touchmove',function(){if(t){clearTimeout(t);t=null;}},false);
  target.addEventListener('mousedown',function(){t=setTimeout(fn,ms);},false);
  target.addEventListener('mouseup',function(){if(t){clearTimeout(t);t=null;}},false);
  target.addEventListener('mouseleave',function(){if(t){clearTimeout(t);t=null;}},false);
}
function initMode(){
  // トップバー全体を5秒長押しでモード切替（クリック・ダブルクリック無効）
  var tb=el('topbar');
  if(tb)addLongPress(tb,5000,function(){trySwitch(getMode()==='husband'?'wife':'husband');});
  var hw=el('btn-sw-husb');if(hw)hw.addEventListener('click',function(){trySwitch('husband');});
  var ww=el('btn-sw-wife');if(ww)ww.addEventListener('click',function(){trySwitch('wife');});
  var mc=el('mcancel');if(mc)mc.addEventListener('click',closeModal);
  var mok=el('mok');if(mok)mok.addEventListener('click',confirmModal);
  var mp=el('mpw');
  if(mp)mp.addEventListener('keydown',function(e){if(e.key==='Enter')confirmModal();});
  var mo=el('modal');
  if(mo)mo.addEventListener('click',function(e){if(e.target===mo)closeModal();});
}
function trySwitch(m){
  var s=getSettings(),pw=m==='husband'?s.husbandPassword:s.wifePassword;
  if(!pw){applyMode(m);return;}
  ST.pendingMode=m;
  var mt=el('mtitle');if(mt)mt.textContent=(m==='husband'?'夫':'妻')+'モードへ切替';
  var mp=el('mpw');if(mp)mp.value='';
  var me=el('merr');if(me)me.classList.remove('on');
  var mo=el('modal');if(mo){mo.classList.add('op');setTimeout(function(){if(mp)mp.focus();},100);}
}
function confirmModal(){
  var mp=el('mpw'),pw=mp?mp.value:'';
  var s=getSettings(),stored=ST.pendingMode==='husband'?s.husbandPassword:s.wifePassword;
  if(verifyPw(pw,stored)){
    var m=ST.pendingMode;  // closeModal前に保存（closeModalがpendingModeをnullにするため）
    closeModal();
    applyMode(m);
  } else {
    var me=el('merr');if(me)me.classList.add('on');
  }
}
function closeModal(){
  var mo=el('modal');if(mo)mo.classList.remove('op');
  ST.pendingMode=null;
}
function applyMode(m){
  setMode(m);
  updateModeBtns();
  var husbOnly=['salary-stitle','salary-card','mode-card','amex-card'];
  for(var i=0;i<husbOnly.length;i++){
    var e=el(husbOnly[i]);
    if(e){if(m==='husband')e.classList.remove('hidden');else e.classList.add('hidden');}
  }
  if(ST.result)renderResult();
  toast(m==='husband'?'夫モードに切り替えました':'通常モードに戻りました');
}

// 前回入力の復元
function restoreInput(){
  var last=getLastInput();if(!last)return;
  var map=[['i-salary','salary'],['i-travel','travel'],['i-hp','hp'],['i-wp','wp'],['i-bal','bal'],['i-credit','credit']];
  for(var i=0;i<map.length;i++){
    var e=el(map[i][0]);
    if(e&&last[map[i][1]]!==undefined)e.value=last[map[i][1]];
  }
}

// ===== 起動 =====
(function init(){
  try{
    var d=document.getElementById('debug-bar');
    if(d){d.textContent='初期化完了 - 正常動作中';d.style.background='#34a853';}
    setTimeout(function(){if(d&&d.style.background==='rgb(52, 168, 83)')d.style.display='none';},2000);

    initNav();
    initUploads();
    initCalc();
    initSettingsForm();
    initMode();
    initSegs();
    loadSettingsForm();
    restoreInput();
    // 初期化時はトーストを出さず静かにモードを適用
    setMode('wife');
    updateModeBtns();
    var _els=['salary-stitle','salary-card','mode-card','amex-card'];
    for(var _i=0;_i<_els.length;_i++){var _e=el(_els[_i]);if(_e)_e.classList.add('hidden');}
    if(ST.result)renderResult();
  }catch(e){
    var d=document.getElementById('debug-bar');
    if(d){d.textContent='初期化エラー: '+e.message;d.style.display='block';d.style.background='#ea4335';}
    console.error(e);
  }
})();
</script>
</body>
</html>
